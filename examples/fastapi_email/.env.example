# Copy this file to .env for local Docker runs.
# Never commit real secret values.

# Dimail
DIMAIL_API_KEY=
# DIMAIL_HOST=https://admin.dimail.hu
# DIMAIL_TIMEOUT=15

# Microsoft Graph
# The Azure app registration must have application permission to send mail
# for the selected sender mailbox, such as Mail.Send with admin consent.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=
# MS_GRAPH_TIMEOUT=10
# MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
