# MIT-utils environment template.
# Copy values into your consuming app's environment as needed.
# Never commit real secret values.

# Auth0 authentication
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# Generic JWT authentication
# JWT_SECRET_KEY=my_secret_key
# JWT_SIGN_ALGORITHM=HS256
# JWT_SECRET_PASSWORD=

# Dimail/ninjaMail
DIMAIL_API_KEY=
# DIMAIL_HOST=https://admin.dimail.hu

# Microsoft Graph email
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=

# Gmail API email
GMAIL_SENDER_EMAIL=
# GMAIL_DELEGATED_SUBJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Or use GOOGLE_SERVICE_ACCOUNT_INFO instead of GOOGLE_APPLICATION_CREDENTIALS
# when the service account JSON is supplied by a secret manager.
# GOOGLE_SERVICE_ACCOUNT_INFO={"type":"service_account",...}
# GMAIL_TIMEOUT=10

# Bulk email pacing
# BULK_EMAIL_DELAY_SECONDS=0.2
